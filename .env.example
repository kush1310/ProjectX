# ===================================================================
# CHARUSAT NEEDS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. In cloud deployments (Render, Vercel),
# set these directly in the provider's Environment Variables dashboard.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ===================================================================

# -------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Local PostgreSQL or Neon Cloud)
# -------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/charusatneeds
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password_here
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# -------------------------------------------------------------------
# 2. CACHE & REDIS CONFIGURATION (Local Redis or Upstash Cloud)
# -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
# Upstash REST / RESP connection URI (Alternative to host/port):
REDIS_URL=rediss://default:your_upstash_token@your-upstash-instance.upstash.io:6379

# -------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY (AES-256-GCM and HMAC-SHA256)
# -------------------------------------------------------------------
# 256-bit Base64-encoded secret for JWT generation
JWT_SECRET=your_base64_256bit_jwt_secret_here
JWT_EXPIRATION=900000

# 32-character key for AES-256-GCM sensitive database column encryption
FIELD_ENCRYPTION_KEY=your_32char_field_encryption_key_here

# 32-character key for AES-256-GCM API payload encryption
PAYLOAD_ENCRYPTION_KEY=your_32char_payload_encryption_key_here

# -------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Google Cloud Console — Institutional SSO)
# -------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-frontend-domain.vercel.app/auth/callback

# -------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Brevo HTTPS API)
# -------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@charusat.edu.in
BREVO_SENDER_NAME=CharusatNeeds Production
# Legacy alias support:
SMTP_USERNAME=your_verified_sender@charusat.edu.in
SMTP_PASSWORD=your_brevo_api_key_here

# -------------------------------------------------------------------
# 6. PAYMENT GATEWAY (Razorpay Test Mode)
# -------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -------------------------------------------------------------------
# 7. MEDIA & OBJECT STORAGE (ImageKit CDN + Backblaze B2 / MinIO)
# -------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET=charusatneeds-media
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key

# -------------------------------------------------------------------
# 8. APPLICATION & CORS ORIGINS
# -------------------------------------------------------------------
PORT=8000
SPRING_PROFILES_ACTIVE=prod
FRONTEND_URL=https://your-frontend-domain.vercel.app
BACKEND_URL=https://your-backend-service.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------------
# 9. FRONTEND (Vite / Vercel Environment Variables)
# -------------------------------------------------------------------
VITE_API_URL=https://your-backend-service.onrender.com/api
VITE_WS_URL=wss://your-backend-service.onrender.com/ws/websocket
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://your-frontend-domain.vercel.app/auth/callback
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
