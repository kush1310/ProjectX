<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />
    <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter" />

    <!-- Standard Local Pattern -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%X{requestId:-none}]){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx"/>

    <!-- Structured Production Pattern (Machine-readable / CloudWatch / ELK ingestible) -->
    <property name="PROD_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} severity=%level service=charusat-backend reqId=%X{requestId:-none} thread=%thread logger=%logger message=%replace(%m){'[\r\n]+', ' '}%n%wEx"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <springProfile name="!prod">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </springProfile>
        <springProfile name="prod">
            <encoder>
                <pattern>${PROD_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </springProfile>
    </appender>

    <!-- Environment Profiling -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
        <logger name="com.charusat.canteen" level="DEBUG" />
        <logger name="org.springframework.security" level="DEBUG" />
    </springProfile>

    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE" />
        </root>
        <logger name="com.charusat.canteen" level="INFO" />
        <logger name="org.springframework.security" level="WARN" />
        <logger name="org.springframework.web" level="WARN" />
        <logger name="com.zaxxer.hikari" level="WARN" />
    </springProfile>

</configuration>
