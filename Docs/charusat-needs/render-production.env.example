# ===================================================================
# CHARUSAT NEEDS -- RENDER PRODUCTION ENVIRONMENT TEMPLATE
# ===================================================================
# This file contains ONLY variable names and safe placeholder values.
# NO real credentials appear here.
# Copy this list to the Render Dashboard -> Environment -> Add Variable.
# Do NOT commit a file containing real values to version control.
# ===================================================================
# Generated: 2026-09-24 | Profile: prod | Region: Singapore | Runtime: Docker
# ===================================================================

# -------------------------------------------------------------------
# PROFILE & PORT (set by render.yaml; confirm in Dashboard)
# -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8000

# -------------------------------------------------------------------
# DATABASE (Neon PostgreSQL - Singapore pooler endpoint)
# Source: Neon Dashboard -> Connection Details -> Connection String
# Use the POOLED endpoint URL. Convert to JDBC format.
# Format: jdbc:postgresql://<host>/neondb?sslmode=require
# -------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_POOLER_HOST>/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=<NEON_USERNAME>
SPRING_DATASOURCE_PASSWORD=<SECRET_FROM_NEON>
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# -------------------------------------------------------------------
# REDIS CACHE (Upstash Redis - TLS via RESP3)
# Source: Upstash Dashboard -> Database -> Details -> REDIS_URL
# Format: rediss://default:<token>@<endpoint>.upstash.io:6379
# -------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=rediss://default:<UPSTASH_TOKEN>@true-insect-295406.upstash.io:6379
REDIS_TTL_SECONDS=300

# -------------------------------------------------------------------
# SECURITY & CRYPTOGRAPHY
# JWT_SECRET: Generate with: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# FIELD_ENCRYPTION_KEY: Exactly 32 characters (AES-256-GCM for DB column encryption)
# PAYLOAD_ENCRYPTION_KEY: Exactly 32 characters (AES-256-GCM for API payload encryption)
# -------------------------------------------------------------------
JWT_SECRET=<BASE64_256BIT_JWT_SECRET>
JWT_EXPIRATION=900000
FIELD_ENCRYPTION_KEY=<EXACTLY_32_CHAR_AES_KEY_HERE>
PAYLOAD_ENCRYPTION_KEY=<EXACTLY_32_CHAR_AES_KEY_HERE>

# -------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Brevo HTTPS REST API)
# Source: Brevo Dashboard -> API Keys -> Generate v3 Key
# BREVO_SENDER_EMAIL must be a verified sender in Brevo.
# -------------------------------------------------------------------
BREVO_API_KEY=<BREVO_API_KEY>
BREVO_SENDER_EMAIL=<VERIFIED_BREVO_SENDER_EMAIL>
BREVO_SENDER_NAME=Charusat Needs

# -------------------------------------------------------------------
# GOOGLE OAUTH 2.0 (Campus SSO)
# Source: Google Cloud Console -> APIs -> Credentials -> Web Client
# GOOGLE_REDIRECT_URI must exactly match the Authorized Redirect URI in Google Console.
# -------------------------------------------------------------------
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://<YOUR_VERCEL_PROJECT>.vercel.app/auth/callback

# -------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay Test Mode)
# Source: Razorpay Test Dashboard -> Settings -> API Keys
# Note: Rotate these credentials after removing from Docs/cloud-environment-matrix.md
# -------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_<TEST_KEY_ID>
RAZORPAY_KEY_SECRET=<RAZORPAY_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<RAZORPAY_WEBHOOK_SECRET>

# -------------------------------------------------------------------
# MEDIA STORAGE (ImageKit CDN)
# Source: ImageKit Dashboard -> Developer Options -> API Keys
# IMAGEKIT_PUBLIC_KEY and IMAGEKIT_URL_ENDPOINT have safe defaults in application.properties
# Set them explicitly here for clarity and future account portability.
# -------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=public_+grCFOmI0qDm3NTqiEhsvLFrhgc=
IMAGEKIT_PRIVATE_KEY=<IMAGEKIT_PRIVATE_KEY>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/cyseckush/
MEDIA_STORAGE_PROVIDER=imagekit

# -------------------------------------------------------------------
# BACKBLAZE B2 OBJECT STORAGE (Optional - not active in current build)
# Leave blank. Only set if activating B2 as primary storage provider.
# -------------------------------------------------------------------
B2_ENDPOINT=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# -------------------------------------------------------------------
# URLs & CORS CONFIGURATION
# Set BOTH values after Vercel deployment URL is confirmed.
# CORS_ALLOWED_ORIGINS: comma-separated list (no trailing slash)
# Note: Also requires SecurityConfig.java CORS fix to take effect.
# -------------------------------------------------------------------
FRONTEND_URL=https://<YOUR_VERCEL_PROJECT>.vercel.app
CORS_ALLOWED_ORIGINS=https://<YOUR_VERCEL_PROJECT>.vercel.app

# ===================================================================
# VARIABLES NOT INCLUDED IN THIS FILE
# ===================================================================
# The following are FRONTEND-ONLY variables. Set them in Vercel Dashboard only:
#   VITE_API_URL         = https://<your-render-service>.onrender.com/api
#   VITE_WS_URL          = wss://<your-render-service>.onrender.com/ws/websocket
#   VITE_GOOGLE_CLIENT_ID
#   VITE_GOOGLE_REDIRECT_URI
#   VITE_IMAGEKIT_URL_ENDPOINT
#   VITE_IMAGEKIT_PUBLIC_KEY
#   VITE_ENV             = production
# ===================================================================
