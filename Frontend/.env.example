# CharusatNeeds Frontend Environment Variables
# Copy this file to .env and fill in your values

# ==================== Google OAuth ====================
# Get these from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# OAuth redirect URI (must match Google Console settings)
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# ==================== Backend API ====================
# Development backend URL
VITE_API_URL=http://localhost:8080/api

# ==================== Environment ====================
VITE_ENV=development

# ==================== Instructions ====================
# 1. Create Google OAuth credentials:
#    - Go to https://console.cloud.google.com/
#    - Create new project "CharusatNeeds"
#    - Enable Google+ API
#    - Create OAuth client ID (Web application)
#    - Add authorized origins: http://localhost:5173
#    - Add redirect URI: http://localhost:5173/auth/callback
#    - Copy Client ID to VITE_GOOGLE_CLIENT_ID
#
# 2. Domain restriction is enforced via:
#    - Frontend: hd=charusat.edu.in parameter in OAuth URL
#    - Backend: Verify 'hd' claim in Google token
#
# 3. For production, update:
#    - VITE_GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/callback
#    - VITE_API_URL=https://api.yourdomain.com
#    - Add production URLs to Google Console
