# ===================================================================
# CHARUSAT NEEDS - VERCEL PRODUCTION ENVIRONMENT TEMPLATE
# ===================================================================
# This file contains the exact environment variables required by the
# React Single Page Application when deployed to Vercel.
#
# IMPORTANT RULES FOR VERCEL:
# 1. Do NOT commit production values with sensitive data to version control.
# 2. In Vite, ALL variables starting with VITE_ are embedded into the client
#    JavaScript bundle and are visible to end users in the browser.
# 3. Do NOT add private keys, database passwords, or JWT secrets here.
# 4. In the Vercel Dashboard: Project Settings > Environment Variables.
# ===================================================================

# -------------------------------------------------------------------
# 1. BACKEND REST API URL (Required)
# -------------------------------------------------------------------
# The HTTPS URL of your Render Spring Boot Web Service.
# Code supports either with or without trailing /api.
# Example: https://charusatneeds-backend.onrender.com/api
VITE_API_URL=https://<your-render-backend-name>.onrender.com/api

# -------------------------------------------------------------------
# 2. WEBSOCKET BROKER URL (Optional - Recommended)
# -------------------------------------------------------------------
# Direct STOMP WebSocket broker endpoint on Render backend.
# If omitted, frontend automatically derives this from VITE_API_URL:
# https://... -> wss://.../ws/websocket
# Example: wss://charusatneeds-backend.onrender.com/ws/websocket
VITE_WS_URL=wss://<your-render-backend-name>.onrender.com/ws/websocket

# -------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 CLIENT ID (Required for Google SSO)
# -------------------------------------------------------------------
# Client ID from Google Cloud Console > Credentials.
# This is a public identifier safe for client-side embedding.
# Example: 123456789012-abcdef123456789.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# -------------------------------------------------------------------
# 4. GOOGLE OAUTH REDIRECT URI (Optional - Recommended)
# -------------------------------------------------------------------
# The frontend URL where Google redirects users after authentication.
# Must strictly match the Authorized Redirect URI in Google Cloud Console.
# If omitted, defaults dynamically to ${window.location.origin}/auth/callback.
# Example: https://charusatneeds.vercel.app/auth/callback
VITE_GOOGLE_REDIRECT_URI=https://<your-vercel-domain>.vercel.app/auth/callback

# -------------------------------------------------------------------
# 5. IMAGEKIT CDN URL ENDPOINT (Optional)
# -------------------------------------------------------------------
# Base endpoint for real-time image transformations and delivery.
# If omitted, defaults to https://ik.imagekit.io/cyseckush/
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/cyseckush/
